{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "report/**"
    }
  },
  "rewrites": [
    {
      "source": "/ftw/(.*)",
      "destination": "https://data.source.coop/ftw/global-field-boundaries/pmtiles/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
