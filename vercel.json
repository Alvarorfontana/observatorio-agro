{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{report/**,data/**,spectral_indices.json}",
      "excludeFiles": "{node_modules/**,dist/**,src/**,public/**,evidencia/**,tests/**,*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/ftw/(.*)",
      "destination": "https://data.source.coop/ftw/global-field-boundaries/pmtiles/$1"
    },
    {
      "source": "/dem/(.*)",
      "destination": "https://copernicus-dem-30m.s3.amazonaws.com/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/poblacion",
      "destination": "/poblacion/index.html"
    },
    {
      "source": "/avisos-widget",
      "destination": "/avisos-widget/index.html"
    },
    {
      "source": "/((?!api/|ftw/|dem/|assets/|poblacion|avisos-widget).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/avisos-widget/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "diag-*": false,
      "capturas": false
    }
  }
}